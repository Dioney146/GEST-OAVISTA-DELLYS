{
  "functions": {
    "api/dados.js": { "includeFiles": "data/**" }
  },
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)dados'",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
